        {
          "name": "Token Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// old script\r",
                  "\r",
                  "// Check status code is 200 OK\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Check success message\r",
                  "pm.test(\"Response has refresh success detail\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.detail).to.eql(\"Token refreshed\");\r",
                  "});\r",
                  "\r",
                  "// Check access_token cookie is present (it should be updated)\r",
                  "pm.test(\"Access token cookie exists\", function () {\r",
                  "    pm.expect(pm.cookies.has('access_token')).to.be.true;\r",
                  "});\r",
                  "\r",
                  "// Automatically update access_token environment variable\r",
                  "const accessToken = pm.cookies.get('access_token');\r",
                  "if (accessToken) {\r",
                  "    pm.environment.set('access_token', accessToken);\r",
                  "    console.log('access_token refreshed and saved to environment');\r",
                  "}\r",
                  "\r",
                  "// new script\r",
